{
    "name": "erfindergeist/backup-wp-plugin",
    "description": "Erfindergeist Backup — WordPress Plugin",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "phpmyadmin/sql-parser": "^5.10"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.12",
        "phpstan/extension-installer": "^1.4",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "vimeo/psalm": "^5.25",
        "humanmade/psalm-plugin-wordpress": "^3.0",
        "phpmd/phpmd": "^2.15"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "phpcbf":   "phpcbf",
        "phpcs":    "phpcs",
        "phpstan":  "phpstan analyse --no-progress --memory-limit 512M",
        "psalm":    "psalm --taint-analysis --no-progress",
        "phpmd":    "phpmd . text .phpmd.xml --exclude vendor/,backups/",
        "analyse": ["@phpcs", "@phpstan", "@psalm", "@phpmd"]
    }
}
